{
  "name": "@saturn/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "oxlint -c ../.oxlintrc.json --deny-warnings src scripts",
    "dev": "tauri dev",
    "build": "vite build",
    "fetch:model": "node scripts/fetch-embedding-model.mjs",
    "stage:binaries": "node scripts/stage-rust-binaries.mjs",
    "package": "npm run build && npm run fetch:model && npm run stage:binaries && tauri build --config src-tauri/tauri.package.json",
    "archive": "node scripts/release-files.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@iconify-json/logos": "^1.2.17",
    "@iconify-json/simple-icons": "^1.2.100",
    "@iconify/utils": "^3.1.7",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}

node_modules/
dist/
release/
*.log
.DS_Store
# Saturn IDE builds (the app bundles live next to Saturn-IDE/, whose own .gitignore covers its build output)
VSCode-darwin-*/
# The pinned Node a developer may keep for building Saturn IDE (see Saturn-IDE/.nvmrc)
Saturn-IDE/.node/

# Linked worktrees created for side sessions
.claude/worktrees/
# Local runtime working data (generated when running the dev runtime from this folder)
runtime/.artifacts/
runtime/.agents/
runtime/plugins/

# Lifecycle test package (electron-builder --config.directories.output=release-test)
desktop/release-test/

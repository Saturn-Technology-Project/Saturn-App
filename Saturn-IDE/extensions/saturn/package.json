{
  "name": "saturn",
  "displayName": "Saturn",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "saturn",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Themes",
    "AI",
    "Chat"
  ],
  "main": "./extension.js",
  "enabledApiProposals": [
    "contribSourceControlInputBoxMenu"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "themes": [
      {
        "id": "Saturn Dark",
        "label": "Saturn Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/saturn-dark.json"
      },
      {
        "id": "Saturn Light",
        "label": "Saturn Light",
        "uiTheme": "vs",
        "path": "./themes/saturn-light.json"
      }
    ],
    "configurationDefaults": {
      "workbench.colorTheme": "Saturn Dark",
      "workbench.preferredDarkColorTheme": "Saturn Dark",
      "workbench.preferredLightColorTheme": "Saturn Light",
      "workbench.experimental.modernUI": true,
      "workbench.modernUIFrostedGlass": true,
      "workbench.experimental.modernUIEditorTabStyle": "connected",
      "workbench.activityBar.location": "top",
      "workbench.secondarySideBar.defaultVisibility": "visible",
      "workbench.startupEditor": "none",
      "workbench.tips.enabled": false,
      "workbench.layoutControl.enabled": true,
      "workbench.navigationControl.enabled": false,
      "window.commandCenter": true,
      "chat.disableAIFeatures": true,
      "editor.fontFamily": "'SF Mono', 'JetBrains Mono', Menlo, Monaco, Consolas, monospace",
      "editor.fontSize": 13,
      "editor.lineHeight": 20,
      "editor.minimap.enabled": false,
      "editor.cursorBlinking": "smooth",
      "editor.cursorSmoothCaretAnimation": "on",
      "editor.smoothScrolling": true,
      "editor.renderLineHighlight": "all",
      "editor.guides.bracketPairs": "active",
      "editor.stickyScroll.enabled": true,
      "workbench.tree.indent": 14,
      "workbench.tree.renderIndentGuides": "onHover",
      "terminal.integrated.fontSize": 12,
      "breadcrumbs.enabled": true,
      "workbench.editor.enablePreview": true,
      "workbench.editor.enablePreviewFromQuickOpen": true,
      "files.autoSave": "afterDelay",
      "files.autoSaveDelay": 1000,
      "extensions.ignoreRecommendations": true,
      "workbench.remoteIndicator.showExtensionRecommendations": false,
      "workbench.editor.empty.hint": "hidden",
      "workbench.settings.enableNaturalLanguageSearch": false,
      "chat.titleBar.signIn.enabled": false,
      "workbench.activity.showAccounts": false,
      "workbench.layoutControl.type": "toggles",
      "chat.agentHost.otel.enabled": true,
      "chat.agentHost.otel.exporterType": "otlp-http",
      "chat.agentHost.otel.otlpEndpoint": "http://127.0.0.1:4700",
      "window.density.layout": "compact"
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "saturn.runtimeUrl": {
          "type": "string",
          "default": "http://127.0.0.1:4700",
          "description": "%saturn.runtimeUrl%"
        },
        "saturn.completions.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%saturn.completions.enabled%"
        },
        "saturn.codebase.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%saturn.codebase.enabled%"
        },
        "saturn.codebase.index": {
          "type": "boolean",
          "default": true,
          "description": "%saturn.codebase.index%"
        },
        "saturn.nextEdit.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%saturn.nextEdit.enabled%"
        },
        "saturn.commitMessage.instructions": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "editPresentation": "multilineText",
          "markdownDescription": "%saturn.commitMessage.instructions%"
        },
        "saturn.agentTerminal.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%saturn.agentTerminal.enabled%"
        },
        "saturn.verify.auto": {
          "type": "boolean",
          "default": true,
          "description": "%saturn.verify.auto%"
        },
        "saturn.verify.command": {
          "type": "string",
          "default": "",
          "markdownDescription": "%saturn.verify.command%"
        }
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "saturn",
          "title": "%viewsContainers.saturn%",
          "icon": "media/saturn.svg"
        }
      ]
    },
    "views": {
      "saturn": [
        {
          "type": "webview",
          "id": "saturn.agent",
          "name": "%views.saturn.agent%"
        }
      ],
      "explorer": [
        {
          "id": "saturn.runs",
          "name": "%views.saturn.runs%",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "saturn.focusAgent",
        "title": "%command.saturn.focusAgent%",
        "category": "Saturn",
        "icon": "media/saturn.svg"
      },
      {
        "command": "saturn.newChat",
        "title": "%command.saturn.newChat%",
        "category": "Saturn",
        "icon": "$(add)"
      },
      {
        "command": "saturn.openApp",
        "title": "%command.saturn.openApp%",
        "category": "Saturn"
      },
      {
        "command": "saturn.openAppSettings",
        "title": "%command.saturn.openAppSettings%",
        "category": "Saturn"
      },
      {
        "command": "saturn.openAgentWindow",
        "title": "%command.saturn.openAgentWindow%",
        "category": "Saturn",
        "icon": "media/saturn.svg"
      },
      {
        "command": "saturn.inlineEdit",
        "title": "%command.saturn.inlineEdit%",
        "category": "Saturn",
        "icon": "media/saturn.svg"
      },
      {
        "command": "saturn.inlineEdit.accept",
        "title": "%command.saturn.inlineEdit.accept%",
        "category": "Saturn"
      },
      {
        "command": "saturn.inlineEdit.reject",
        "title": "%command.saturn.inlineEdit.reject%",
        "category": "Saturn"
      },
      {
        "command": "saturn.inlineEdit.cancel",
        "title": "%command.saturn.inlineEdit.cancel%",
        "category": "Saturn"
      },
      {
        "command": "saturn.git.generateCommitMessage",
        "title": "%command.saturn.git.generateCommitMessage%",
        "category": "Saturn",
        "icon": "$(sparkle)"
      },
      {
        "command": "saturn.toggleCompletions",
        "title": "%command.saturn.toggleCompletions%",
        "category": "Saturn"
      },
      {
        "command": "saturn.showAgentTerminal",
        "title": "%command.saturn.showAgentTerminal%",
        "category": "Saturn"
      },
      {
        "command": "saturn.nextEdit.accept",
        "title": "%command.saturn.nextEdit.accept%",
        "category": "Saturn"
      },
      {
        "command": "saturn.nextEdit.dismiss",
        "title": "%command.saturn.nextEdit.dismiss%",
        "category": "Saturn"
      },
      {
        "command": "saturn.editRules",
        "title": "%command.saturn.editRules%",
        "category": "Saturn"
      },
      {
        "command": "saturn.openAgentChat",
        "title": "%command.saturn.openAgentChat%",
        "category": "Saturn"
      },
      {
        "command": "saturn.fixWithAgent",
        "title": "%command.saturn.fixWithAgent%",
        "category": "Saturn"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "saturn.newChat",
          "when": "view == saturn.agent",
          "group": "navigation"
        }
      ],
      "scm/inputBox": [
        {
          "command": "saturn.git.generateCommitMessage",
          "when": "scmProvider == git"
        }
      ],
      "editor/context": [
        {
          "command": "saturn.inlineEdit",
          "when": "editorTextFocus && !editorReadonly",
          "group": "1_saturn"
        }
      ],
      "commandPalette": [
        {
          "command": "saturn.git.generateCommitMessage",
          "when": "config.git.enabled && !git.missing && gitOpenRepositoryCount != 0"
        },
        {
          "command": "saturn.inlineEdit.accept",
          "when": "saturn.inlineEditPending"
        },
        {
          "command": "saturn.inlineEdit.reject",
          "when": "saturn.inlineEditPending"
        },
        {
          "command": "saturn.inlineEdit.cancel",
          "when": "saturn.inlineEditBusy"
        },
        {
          "command": "saturn.openAgentChat",
          "when": "false"
        },
        {
          "command": "saturn.fixWithAgent",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "saturn.focusAgent",
        "key": "ctrl+l",
        "mac": "cmd+l"
      },
      {
        "command": "saturn.openAgentWindow",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "saturn.inlineEdit",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && !editorReadonly && !saturn.inlineEditPending"
      },
      {
        "command": "saturn.inlineEdit.accept",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "saturn.inlineEditPending && editorTextFocus"
      },
      {
        "command": "saturn.inlineEdit.reject",
        "key": "escape",
        "when": "saturn.inlineEditPending && editorTextFocus && !suggestWidgetVisible && !findWidgetVisible && !inlineSuggestionVisible"
      },
      {
        "command": "saturn.inlineEdit.cancel",
        "key": "escape",
        "when": "saturn.inlineEditBusy"
      },
      {
        "key": "tab",
        "command": "saturn.nextEdit.accept",
        "when": "saturn.nextEditPending && editorTextFocus && !inlineSuggestionVisible && !suggestWidgetVisible && !inSnippetMode && !editorHasSelection"
      },
      {
        "key": "escape",
        "command": "saturn.nextEdit.dismiss",
        "when": "saturn.nextEditPending && editorTextFocus && !inlineSuggestionVisible && !suggestWidgetVisible"
      }
    ],
    "walkthroughs": [
      {
        "id": "saturn.welcome",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "connect",
            "title": "%walkthrough.connect.title%",
            "description": "%walkthrough.connect.description%",
            "media": {
              "markdown": "media/walkthrough/connect.md"
            },
            "completionEvents": [
              "onContext:saturn.runtimeConnected"
            ]
          },
          {
            "id": "chat",
            "title": "%walkthrough.chat.title%",
            "description": "%walkthrough.chat.description%",
            "media": {
              "markdown": "media/walkthrough/chat.md"
            },
            "completionEvents": [
              "onCommand:saturn.focusAgent"
            ]
          },
          {
            "id": "inline",
            "title": "%walkthrough.inline.title%",
            "description": "%walkthrough.inline.description%",
            "media": {
              "markdown": "media/walkthrough/inline.md"
            },
            "completionEvents": [
              "onCommand:saturn.inlineEdit"
            ]
          },
          {
            "id": "tab",
            "title": "%walkthrough.tab.title%",
            "description": "%walkthrough.tab.description%",
            "media": {
              "markdown": "media/walkthrough/tab.md"
            },
            "completionEvents": [
              "onCommand:saturn.openAppSettings",
              "onSettingChanged:saturn.completions.enabled"
            ]
          },
          {
            "id": "index",
            "title": "%walkthrough.index.title%",
            "description": "%walkthrough.index.description%",
            "media": {
              "markdown": "media/walkthrough/index.md"
            },
            "completionEvents": [
              "onContext:saturn.indexReady"
            ]
          },
          {
            "id": "rules",
            "title": "%walkthrough.rules.title%",
            "description": "%walkthrough.rules.description%",
            "media": {
              "markdown": "media/walkthrough/rules.md"
            },
            "completionEvents": [
              "onCommand:saturn.editRules"
            ]
          },
          {
            "id": "background",
            "title": "%walkthrough.background.title%",
            "description": "%walkthrough.background.description%",
            "media": {
              "markdown": "media/walkthrough/background.md"
            },
            "completionEvents": [
              "onView:saturn.runs"
            ]
          }
        ]
      }
    ]
  },
  "l10n": "./l10n"
}

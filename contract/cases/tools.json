 {
  "check": "patch",
  "patch": "*** Begin Patch\n*** Update File: x.js\n@@\n function a() {\n-  return 1;\n+  return 10;\n }\n",
  "source": "function a() {\n  return 1;\n}\n\nfunction b() {\n  return 2;\n}\n",
  "expect": {
   "ok": {
    "changes": [
     {
      "kind": "update",
      "path": "x.js",
      "hunks": [
       {
        "old": [
         "function a() {",
         "  return 1;",
         "}"
        ],
        "next": [
         "function a() {",
         "  return 10;",
         "}"
        ]
       }
      ]
     }
    ],
    "applied": {
     "ok": "function a() {\n  return 10;\n}\n\nfunction b() {\n  return 2;\n}\n"
    }
   }
  }
 },
 {
  "check": "patch",
  "patch": "*** Begin Patch\n*** Update File: x.js\n@@\n }\n\n function b() {\n-  return 2;\n+  return 20;\n*** End Patch\n",
  "source": "function a() {\n  return 1;\n}\n\nfunction b() {\n  return 2;\n}\n",
  "expect": {
   "ok": {
